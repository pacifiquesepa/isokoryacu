generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  seller
  admin
  super_admin
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  fulfilled
  cancelled
}

enum DeliveryZone {
  kigali
  outside_kigali
  international
}

enum OrderNotificationChannel {
  in_app
  email
  whatsapp
}

enum OrderNotificationStatus {
  pending
  processing
  sent
  failed
  unavailable
}

enum RefundStatus {
  requested
  approved
  rejected
  refunded
  cancelled
}

enum DisputeStatus {
  open
  under_review
  resolved
  closed
}

enum MarketingStatus {
  draft
  scheduled
  active
  paused
  ended
  cancelled
}

enum DiscountType {
  percentage
  fixed_amount
}

enum MarketingBannerPlacement {
  homepage
  category
  checkout
}

enum MerchantAccessAction {
  suspended
  reactivated
}

enum MerchantKycStatus {
  pending
  approved
}

enum MerchantKycAuditAction {
  approved
  rejected
  erased
  reverification_requested
}

enum LoginOutcome {
  success
  failed
  blocked
}

enum SecurityAlertStatus {
  open
  investigating
  resolved
  dismissed
}

enum SecurityPolicyType {
  password
  session
  access
}

enum PaymentAccountType {
  bank
  mobile_money
}

enum PaymentProofMethod {
  bank_transfer
  mobile_money
}

enum OrderPaymentProofStatus {
  pending
  approved
  rejected
}

enum OrderPaymentMode {
  receipt
  cash_on_delivery
}

enum ProductStockMovementType {
  opening_balance
  sale
  sale_reversal
  adjustment
}

enum MerchantPayoutStatus {
  requested
  paid
  rejected
}

enum MerchantFinancialChangeStatus {
  pending
  approved
  rejected
}

enum AnnouncementAudience {
  all_users
  merchants
  customers
  admins
  specific_users
}

enum AnnouncementPriority {
  urgent
  high
  normal
  low
}

enum OrderFulfillmentMethod {
  delivery
  pickup
}

enum ConversationType {
  customer
  merchant
  staff
}

enum ConversationStatus {
  open
  closed
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

enum SupportTicketPriority {
  low
  normal
  high
  urgent
}

enum CommunicationCampaignStatus {
  draft
  scheduled
  sent
  cancelled
}

enum ProductModerationStatus {
  draft
  pending
  published
  rejected
  hidden
  scheduled
}

enum ProductReportStatus {
  pending
  reviewed
  dismissed
}

enum StaffInvitationStatus {
  pending
  accepted
  cancelled
  expired
}

enum UserStateAuditAction {
  activated
  deactivated
  archived
  restored
}

enum MerchantStaffRole {
  owner
  manager
  operations
  support
  finance
}

enum MerchantStaffStatus {
  active
  inactive
}

model User {
  id                             String                           @id @default(cuid())
  name                           String                           @db.VarChar(100)
  email                          String                           @unique @db.VarChar(254)
  passwordHash                   String                           @db.VarChar(100)
  phone                          String?                          @db.VarChar(32)
  role                           UserRole                         @default(customer)
  isActive                       Boolean                          @default(true)
  archivedAt                     DateTime?
  lastLoginAt                    DateTime?
  isFeaturedMerchant             Boolean                          @default(false)
  twoFactorEnabled               Boolean                          @default(false)
  twoFactorSecret                String?                          @db.VarChar(128)
  twoFactorPendingSecret         String?                          @db.VarChar(128)
  emailTwoFactorEnabled          Boolean                          @default(false)
  emailTwoFactorPendingCodeHash  String?                          @db.Char(64)
  emailTwoFactorPendingExpiresAt DateTime?
  isSuspended                    Boolean                          @default(false)
  isAnonymized                   Boolean                          @default(false)
  products                       Product[]                        @relation("ProductOwner")
  orders                         Order[]                          @relation("CustomerOrders")
  orderNotifications             OrderNotification[]
  orderItemsAsSeller             OrderItem[]                      @relation("SellerOrderItems")
  roleChangesMade                UserRoleAudit[]                  @relation("RoleChangeActor")
  roleChangesReceived            UserRoleAudit[]                  @relation("RoleChangeTarget")
  merchantAccessActionsMade      MerchantAccessAudit[]            @relation("MerchantAccessActor")
  merchantAccessActionsReceived  MerchantAccessAudit[]            @relation("MerchantAccessTarget")
  merchantKyc                    MerchantKyc?
  merchantKycReviews             MerchantKyc[]                    @relation("MerchantKycReviewer")
  merchantKycAuditsMade          MerchantKycAudit[]               @relation("MerchantKycActor")
  paymentProofsSubmitted         OrderPaymentProof[]              @relation("PaymentProofCustomer")
  paymentProofsReviewed          OrderPaymentProof[]              @relation("PaymentProofReviewer")
  announcementsCreated           Announcement[]                   @relation("AnnouncementCreator")
  announcementsCancelled         Announcement[]                   @relation("AnnouncementCanceller")
  announcementRecipients         AnnouncementRecipient[]
  announcementDismissals         AnnouncementDismissal[]
  staffInvitationsCreated        StaffInvitation[]                @relation("StaffInvitationInviter")
  staffInvitationsAccepted       StaffInvitation[]                @relation("StaffInvitationAccepter")
  userStateActionsMade           UserStateAudit[]                 @relation("UserStateActor")
  userStateActionsReceived       UserStateAudit[]                 @relation("UserStateTarget")
  moderatedProducts              Product[]                        @relation("ProductModerator")
  productReportsSubmitted        ProductReport[]                  @relation("ProductReportReporter")
  productReportsReviewed         ProductReport[]                  @relation("ProductReportReviewer")
  merchantStaffMemberships       MerchantStaff[]                  @relation("MerchantStaffUser")
  merchantStaffTeams             MerchantStaff[]                  @relation("MerchantStaffMerchant")
  merchantFinancialProfile       MerchantFinancialProfile?        @relation("MerchantFinancialMerchant")
  merchantFinancialVerifications MerchantFinancialProfile[]       @relation("MerchantFinancialVerifier")
  cashCollectionsRecorded        Order[]                          @relation("OrderCashCollector")
  stockMovementsRecorded         ProductStockMovement[]           @relation("StockMovementActor")
  merchantPayouts                MerchantPayout[]                 @relation("MerchantPayoutOwner")
  merchantPayoutsReviewed        MerchantPayout[]                 @relation("MerchantPayoutReviewer")
  financialChangeRequests        MerchantFinancialChangeRequest[] @relation("FinancialChangeRequester")
  financialChangeReviews         MerchantFinancialChangeRequest[] @relation("FinancialChangeReviewer")
  merchantShop                   MerchantShop?                    @relation("MerchantShopOwner")
  couponsCreated                 Coupon[]                         @relation("CouponCreator")
  couponRedemptions              CouponRedemption[]               @relation("CouponRedemptionUser")
  marketingCampaignsCreated      MarketingCampaign[]              @relation("MarketingCampaignCreator")
  featuredMerchantListing        FeaturedMerchant?                @relation("FeaturedMerchantUser")
  homepageBannersCreated         HomepageBanner[]                 @relation("HomepageBannerCreator")
  loginEvents                    LoginEvent[]                     @relation("LoginEventUser")
  securitySessions               SecuritySession[]                @relation("SecuritySessionUser")
  securityDevices                SecurityDevice[]                 @relation("SecurityDeviceUser")
  securityAlerts                 SecurityAlert[]                  @relation("SecurityAlertUser")
  merchantPreference             MerchantPreference?
  merchantNotifications          MerchantNotification[]
  productViews                   ProductView[]
  productReviews                 ProductReview[]
  favorites                      ProductFavorite[]
  merchantStaffAuditsMade        MerchantStaffAudit[]             @relation("MerchantStaffAuditActor")
  merchantStaffAuditsReceived    MerchantStaffAudit[]             @relation("MerchantStaffAuditTarget")
  merchantStaffAuditsOnMerchant  MerchantStaffAudit[]             @relation("MerchantStaffAuditMerchant")
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt

  @@index([role])
}

model UserRoleAudit {
  id           String   @id @default(cuid()) @db.VarChar(100)
  actorId      String
  targetId     String
  previousRole UserRole
  newRole      UserRole
  actor        User     @relation("RoleChangeActor", fields: [actorId], references: [id], onDelete: Restrict)
  target       User     @relation("RoleChangeTarget", fields: [targetId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
}

model MerchantAccessAudit {
  id        String               @id @default(cuid()) @db.VarChar(100)
  actorId   String
  targetId  String
  action    MerchantAccessAction
  reason    String?              @db.VarChar(500)
  actor     User                 @relation("MerchantAccessActor", fields: [actorId], references: [id], onDelete: Restrict)
  target    User                 @relation("MerchantAccessTarget", fields: [targetId], references: [id], onDelete: Restrict)
  createdAt DateTime             @default(now())

  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
}

model MerchantKyc {
  id                           String            @id @default(cuid()) @db.VarChar(100)
  userId                       String            @unique
  ownerFullName                String            @db.VarChar(100)
  businessName                 String            @db.VarChar(160)
  businessAddress              String            @db.VarChar(500)
  taxId                        String?           @db.VarChar(64)
  registrationDocument         Bytes
  registrationDocumentName     String            @db.VarChar(255)
  registrationDocumentMimeType String            @db.VarChar(100)
  identityDocument             Bytes
  identityDocumentName         String            @db.VarChar(255)
  identityDocumentMimeType     String            @db.VarChar(100)
  status                       MerchantKycStatus @default(pending)
  reviewReason                 String?           @db.VarChar(500)
  reviewedById                 String?
  reviewedAt                   DateTime?
  submittedAt                  DateTime          @default(now())
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  user                         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy                   User?             @relation("MerchantKycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
}

model MerchantKycAudit {
  id            String                 @id @default(cuid()) @db.VarChar(100)
  applicationId String                 @db.VarChar(100)
  actorId       String
  action        MerchantKycAuditAction
  reason        String?                @db.VarChar(500)
  createdAt     DateTime               @default(now())
  actor         User                   @relation("MerchantKycActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Product {
  id                String                  @id @default(cuid()) @db.VarChar(100)
  ownerId           String?
  owner             User?                   @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  orderItems        OrderItem[]
  moderationStatus  ProductModerationStatus @default(draft)
  moderationReason  String?                 @db.VarChar(500)
  moderatedAt       DateTime?
  moderatedById     String?
  moderatedBy       User?                   @relation("ProductModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  scheduledAt       DateTime?
  subcategoryId     String?                 @db.VarChar(100)
  subcategory       ProductSubcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  sku               String?                 @unique @db.VarChar(64)
  brand             String?                 @db.VarChar(120)
  name              String                  @db.VarChar(160)
  nameFr            String?                 @db.VarChar(160)
  nameRw            String?                 @db.VarChar(160)
  description       String?                 @db.Text
  warranty          String?                 @db.VarChar(1000)
  specifications    Json?
  returnPolicy      String?                 @db.VarChar(2000)
  category          String                  @db.VarChar(80)
  categoryInfo      ProductCategoryCatalog  @relation(fields: [category], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  price             Int
  previousPrice     Int?
  rating            Float                   @default(0)
  reviewCount       Int                     @default(0)
  badge             String?                 @db.VarChar(80)
  badgeFr           String?                 @db.VarChar(80)
  badgeRw           String?                 @db.VarChar(80)
  image             String                  @db.VarChar(2048)
  seller            String                  @db.VarChar(160)
  location          String                  @db.VarChar(120)
  stockQuantity     Int                     @default(0)
  lowStockThreshold Int?
  stockMovements    ProductStockMovement[]
  isPublished       Boolean                 @default(false)
  isFeatured        Boolean                 @default(false)
  archivedAt        DateTime?
  uploadedImages    ProductImage[]
  reports           ProductReport[]
  views             ProductView[]
  reviews           ProductReview[]
  favorites         ProductFavorite[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([isPublished, category])
  @@index([isPublished, isFeatured])
  @@index([isPublished, createdAt])
  @@index([isPublished, price])
  @@index([ownerId])
  @@index([moderationStatus, createdAt])
  @@index([moderationStatus, scheduledAt])
}

model ProductCategoryCatalog {
  slug                  String               @id @db.VarChar(80)
  name                  String               @unique @db.VarChar(120)
  description           String?              @db.VarChar(500)
  commissionBasisPoints Int?
  lowStockThreshold     Int?
  products              Product[]
  subcategories         ProductSubcategory[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid()) @db.VarChar(100)
  productId String?  @db.VarChar(100)
  imageData Bytes
  mimeType  String   @db.VarChar(32)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model ProductView {
  id        String   @id @default(cuid()) @db.VarChar(100)
  productId String   @db.VarChar(100)
  viewerId  String?
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewer    User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([productId, viewedAt])
  @@index([viewerId, viewedAt])
}

model ProductReview {
  id         String   @id @default(cuid()) @db.VarChar(100)
  productId  String   @db.VarChar(100)
  reviewerId String
  rating     Int
  comment    String?  @db.VarChar(2000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([productId, reviewerId])
  @@index([productId, createdAt])
  @@index([reviewerId, createdAt])
}

model ProductFavorite {
  id        String   @id @default(cuid()) @db.VarChar(100)
  productId String   @db.VarChar(100)
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

model MerchantPreference {
  merchantId           String   @id
  notificationEmail    Boolean  @default(true)
  notificationInApp    Boolean  @default(true)
  notificationWhatsapp Boolean  @default(false)
  appearance           String   @default("system") @db.VarChar(20)
  language             String   @default("en") @db.VarChar(2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  merchant             User     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantNotification {
  id         String    @id @default(cuid()) @db.VarChar(100)
  merchantId String
  title      String    @db.VarChar(160)
  message    String    @db.VarChar(1000)
  type       String    @db.VarChar(40)
  linkUrl    String?   @db.VarChar(2048)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  merchant   User      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, readAt, createdAt])
  @@index([merchantId, createdAt])
}

model ProductSubcategory {
  id                    String                 @id @default(cuid()) @db.VarChar(100)
  category              String                 @db.VarChar(80)
  categoryInfo          ProductCategoryCatalog @relation(fields: [category], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  name                  String                 @db.VarChar(160)
  slug                  String                 @db.VarChar(180)
  isActive              Boolean                @default(true)
  commissionBasisPoints Int?
  products              Product[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([category, slug])
  @@index([category, isActive])
}

model ProductReport {
  id           String              @id @default(cuid()) @db.VarChar(100)
  productId    String              @db.VarChar(100)
  reporterId   String
  reason       String              @db.VarChar(500)
  status       ProductReportStatus @default(pending)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?             @db.VarChar(500)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter     User                @relation("ProductReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("ProductReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([productId, createdAt])
  @@index([reporterId, createdAt])
}

model Order {
  id                      String                 @id @default(cuid()) @db.VarChar(100)
  customerId              String
  customer                User                   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  idempotencyKey          String                 @db.VarChar(128)
  requestHash             String                 @db.Char(64)
  status                  OrderStatus            @default(pending)
  fulfillmentMethod       OrderFulfillmentMethod @default(delivery)
  deliveryZone            DeliveryZone?
  deliveryFee             Int                    @default(0)
  deliveryEta             String?                @db.VarChar(120)
  paymentMode             OrderPaymentMode?
  cashCollectedAt         DateTime?
  cashCollectionReference String?                @db.VarChar(120)
  cashCollectedById       String?
  cashCollectedBy         User?                  @relation("OrderCashCollector", fields: [cashCollectedById], references: [id], onDelete: SetNull)
  notifyByEmail           Boolean                @default(false)
  notifyByWhatsapp        Boolean                @default(false)
  notificationLanguage    String                 @default("en") @db.VarChar(2)
  pickupLocation          String?                @db.VarChar(500)
  deliveryLatitude        Float?
  deliveryLongitude       Float?
  deliveryName            String                 @db.VarChar(100)
  deliveryPhone           String                 @db.VarChar(32)
  deliveryAddress         String                 @db.VarChar(500)
  subtotal                Int
  currency                String                 @default("RWF") @db.Char(3)
  items                   OrderItem[]
  paymentProofs           OrderPaymentProof[]
  shipments               OrderShipment[]
  refunds                 OrderRefund[]
  disputes                OrderDispute[]
  notifications           OrderNotification[]
  stockMovements          ProductStockMovement[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentMode, cashCollectedAt])
}

model DeliverySettings {
  id               String   @id @default("default") @db.VarChar(32)
  deliveryFeeRwf   Int      @default(0)
  etaKigali        String   @default("2h-1 day") @db.VarChar(120)
  etaOutsideKigali String   @default("4h-2 days") @db.VarChar(120)
  etaInternational String   @default("1-4 days") @db.VarChar(120)
  updatedAt        DateTime @updatedAt
}

model OrderNotification {
  id           String                   @id @default(cuid()) @db.VarChar(100)
  orderId      String?                  @db.VarChar(100)
  order        Order?                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId   String
  customer     User                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel      OrderNotificationChannel
  status       OrderNotificationStatus  @default(pending)
  eventType    String                   @db.VarChar(40)
  title        String                   @db.VarChar(160)
  body         String                   @db.VarChar(1000)
  recipient    String?                  @db.VarChar(320)
  error        String?                  @db.VarChar(500)
  readAt       DateTime?
  sentAt       DateTime?
  processingAt DateTime?
  createdAt    DateTime                 @default(now())

  @@unique([orderId, channel, eventType])
  @@index([customerId, channel, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                      String                 @id @default(cuid()) @db.VarChar(100)
  orderId                 String
  order                   Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId               String?                @db.VarChar(100)
  product                 Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  sellerId                String?
  seller                  User?                  @relation("SellerOrderItems", fields: [sellerId], references: [id], onDelete: SetNull)
  productName             String                 @db.VarChar(160)
  productImage            String                 @db.VarChar(2048)
  sellerName              String                 @db.VarChar(160)
  unitPrice               Int
  quantity                Int
  lineTotal               Int
  merchantUnitPrice       Int                    @default(0)
  platformCommissionUnit  Int                    @default(0)
  merchantLineTotal       Int                    @default(0)
  platformCommissionTotal Int                    @default(0)
  stockMovements          ProductStockMovement[]
  createdAt               DateTime               @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([sellerId, createdAt])
}

model ProductStockMovement {
  id             String                   @id @default(cuid()) @db.VarChar(100)
  productId      String?                  @db.VarChar(100)
  product        Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId        String?                  @db.VarChar(100)
  order          Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId    String?                  @db.VarChar(100)
  orderItem      OrderItem?               @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?                    @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  productName    String                   @db.VarChar(160)
  type           ProductStockMovementType
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  reason         String                   @db.VarChar(500)
  sourceKey      String?                  @unique @db.VarChar(180)
  createdAt      DateTime                 @default(now())

  @@index([productId, createdAt])
  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
}

model OrderShipment {
  id             String    @id @default(cuid()) @db.VarChar(100)
  orderId        String    @db.VarChar(100)
  carrier        String    @db.VarChar(160)
  trackingNumber String    @db.VarChar(160)
  status         String    @db.VarChar(80)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?   @db.VarChar(500)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([trackingNumber])
}

model OrderRefund {
  id            String       @id @default(cuid()) @db.VarChar(100)
  orderId       String       @db.VarChar(100)
  requestedById String
  reviewedById  String?
  amount        Int
  currency      String       @db.Char(3)
  reason        String       @db.VarChar(500)
  status        RefundStatus @default(requested)
  reviewedAt    DateTime?
  refundedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model OrderDispute {
  id           String        @id @default(cuid()) @db.VarChar(100)
  orderId      String        @db.VarChar(100)
  openedById   String
  assignedToId String?
  reason       String        @db.VarChar(500)
  resolution   String?       @db.VarChar(500)
  status       DisputeStatus @default(open)
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model SuperAdminPaymentAccount {
  id            String             @id @default(cuid()) @db.VarChar(100)
  type          PaymentAccountType
  provider      String             @db.VarChar(100)
  accountName   String             @db.VarChar(160)
  accountNumber String             @db.VarChar(100)
  currency      String             @default("RWF") @db.Char(3)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([type, provider, accountNumber, currency], map: "PaymentAccount_account_unique")
  @@index([type, isActive])
  @@index([createdAt])
}

model OrderPaymentProof {
  id                   String                  @id @default(cuid()) @db.VarChar(100)
  orderId              String                  @db.VarChar(100)
  customerId           String
  reviewedById         String?
  amount               Int
  currency             String                  @db.Char(3)
  method               PaymentProofMethod
  transactionReference String                  @db.VarChar(120)
  document             Bytes
  documentName         String                  @db.VarChar(255)
  documentMimeType     String                  @db.VarChar(100)
  status               OrderPaymentProofStatus @default(pending)
  reviewReason         String?                 @db.VarChar(500)
  reviewedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  order                Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer             User                    @relation("PaymentProofCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  reviewedBy           User?                   @relation("PaymentProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model Announcement {
  id            String                  @id @default(cuid()) @db.VarChar(100)
  title         String                  @db.VarChar(160)
  message       String                  @db.VarChar(4000)
  audience      AnnouncementAudience
  priority      AnnouncementPriority    @default(normal)
  startsAt      DateTime
  endsAt        DateTime
  cancelledAt   DateTime?
  createdById   String
  cancelledById String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  createdBy     User                    @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy   User?                   @relation("AnnouncementCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  recipients    AnnouncementRecipient[]
  dismissals    AnnouncementDismissal[]

  @@index([startsAt, endsAt, cancelledAt])
  @@index([audience, startsAt, endsAt])
  @@index([createdAt])
}

model AnnouncementRecipient {
  announcementId String       @db.VarChar(100)
  userId         String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

model AnnouncementDismissal {
  announcementId String       @db.VarChar(100)
  userId         String
  dismissedAt    DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId, dismissedAt])
}

model CommunicationConversation {
