DATABASE_URL="postgresql://postgres:password@localhost:5432/ilphotexshop?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
CRON_SECRET="replace-with-a-random-32-byte-secret"
SECURITY_TOTP_ENCRYPTION_KEY="replace-with-a-separate-base64-encoded-32-byte-key"
AUTH_TRUST_PROXY_HEADERS="false"
SUPER_ADMIN_PASSWORD="Admin12345$"

# Transactional order email notifications (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# WhatsApp Web.js order updates; pair this sender account by scanning the worker QR.
WHATSAPP_WEBJS_ENABLED="false"
WHATSAPP_EXPECTED_NUMBER=""
WHATSAPP_WEBJS_CLIENT_ID="isokoryacu-orders"
WHATSAPP_WEBJS_SESSION_PATH=".wwebjs_auth"
WHATSAPP_BROWSER_PATH=""

# Required in production for catalog and authentication rate limits.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-your-token"
